# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your_random_secret_key_here

# Database Configuration
DATABASE_PATH=data/road_quality.db

# Cryptography Key Paths
KEYS_DIR=data/keys
FERNET_KEY_FILE=data/keys/secret.key
RSA_PRIVATE_KEY_FILE=data/keys/private_key.pem
RSA_PUBLIC_KEY_FILE=data/keys/public_key.pem

# Machine Learning
MODEL_PATH=ml/model/road_classifier.joblib
SCALER_PATH=ml/model/scaler.joblib
METADATA_PATH=ml/model/model_metadata.json

# Geospatial Clustering
DBSCAN_EPS_KM=0.05
DBSCAN_MIN_SAMPLES=2
